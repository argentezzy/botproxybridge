# Links: DEPENDENCIES.md
# install.sh (WITH_TG_WS_PROXY=auto) can install Flowseal tg-ws-proxy if :1443 is free:
#   https://github.com/Flowseal/tg-ws-proxy

# https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# @BotFather tokens allowed on this bridge
ALLOWED_BOT_TOKENS=123456:ABC-DEF,987654:XYZ

# Local MTProto (tg-ws-proxy). Secret auto-synced from /etc/tg-ws-proxy/secret when placeholder.
MTPROXY_HOST=127.0.0.1
MTPROXY_PORT=1443
# Raw 32-hex (no dd/ee). Or /etc/tg-ws-proxy/secret
MTPROXY_SECRET=0123456789abcdef0123456789abcdef

# Bridge listen address
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8096

# Sessions and downloaded files
DATA_DIR=/opt/botproxybridge/data

LOG_LEVEL=INFO
