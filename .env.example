# Download links for tg-ws-proxy and the rest: see DEPENDENCIES.md
# https://github.com/argentezzy/botproxybridge/blob/main/DEPENDENCIES.md

# Telegram API credentials: https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Comma-separated bot tokens from @BotFather — only these may use the bridge
ALLOWED_BOT_TOKENS=123456:ABC-DEF,987654:XYZ

# Local tg-ws-proxy MTProto endpoint (install separately!):
# https://github.com/Flowseal/tg-ws-proxy
# https://github.com/Flowseal/tg-ws-proxy/releases
MTPROXY_HOST=127.0.0.1
MTPROXY_PORT=1443
# Raw 32-hex secret (without dd/ee prefix). Or put it in /etc/tg-ws-proxy/secret
MTPROXY_SECRET=0123456789abcdef0123456789abcdef

# Bridge listen address
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8096

# Sessions and downloaded files
DATA_DIR=/opt/botproxybridge/data

LOG_LEVEL=INFO
