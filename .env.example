# Telegram API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Comma-separated bot tokens allowed to use this bridge
ALLOWED_BOT_TOKENS=123456:ABC-DEF,987654:XYZ

# Local tg-ws-proxy (MTProto) endpoint
MTPROXY_HOST=127.0.0.1
MTPROXY_PORT=1443
# Raw 32-hex secret (without dd/ee prefix). Or put it in /etc/tg-ws-proxy/secret
MTPROXY_SECRET=0123456789abcdef0123456789abcdef

# Bridge listen address
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8096

# Sessions and downloaded files
DATA_DIR=/opt/botproxybridge/data

LOG_LEVEL=INFO
